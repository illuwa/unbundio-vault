{
  "manifest_version": 3,
  "name": "unbundio-vault",
  "version": "0.1.0",
  "description": "Fill logins from your local unbundio-vault. No account, no cloud, no server.",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "unbundio-vault"
  },
  "minimum_chrome_version": "109"
}
